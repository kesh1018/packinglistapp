# Copy to android/keystore.properties (gitignored) and fill in, or set the
# PACKINGPAL_STORE_FILE / PACKINGPAL_STORE_PASSWORD / PACKINGPAL_KEY_ALIAS /
# PACKINGPAL_KEY_PASSWORD environment variables instead.
#
# Create an upload key once (keep it and its passwords backed up safely):
#   keytool -genkeypair -v -keystore ~/keys/packingpal-upload.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/outside/the/repo/packingpal-upload.jks
storePassword=
keyAlias=upload
keyPassword=
